<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/theme_color"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:text="@string/dialog_adb_terminal_title"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/dialog_close_btn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:padding="4dp"
            android:src="@drawable/ic_close" />
    </RelativeLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/dialog_adb_terminal_subtitle"
        android:textColor="#A0AAB5"
        android:textSize="12sp" />

    <!-- Shortcut Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chip_pair"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/btn_selector"
                android:minHeight="0dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="pair"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chip_connect"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/btn_selector"
                android:minHeight="0dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="connect"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chip_devices"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/btn_selector"
                android:minHeight="0dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="devices"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chip_tcpip"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/btn_selector"
                android:minHeight="0dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="tcpip 5555"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chip_kill"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/btn_selector"
                android:minHeight="0dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="kill-server"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Console Output Screen -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="#0E1116"
        android:padding="8dp">

        <ScrollView
            android:id="@+id/console_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <TextView
                android:id="@+id/console_output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="#E0E6ED"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </ScrollView>

        <ProgressBar
            android:id="@+id/console_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|right"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Optional Quick-Apply IP Bar -->
    <LinearLayout
        android:id="@+id/layout_apply_ip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#1B3B2B"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_detected_ip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#2ECC71"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_apply_ip"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/btn_selector"
            android:minHeight="0dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="@string/dialog_adb_terminal_apply_ip"
            android:textColor="@color/white"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/edit_command"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/edit_background"
            android:hint="@string/dialog_adb_terminal_hint"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:textColor="@color/white"
            android:textColorHint="#606B78"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_run"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginLeft="6dp"
            android:background="@drawable/btn_selector"
            android:minHeight="0dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="@string/dialog_adb_terminal_run"
            android:textColor="@color/white"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>

